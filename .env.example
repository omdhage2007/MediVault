# MediVault — environment variables
# Copy to `.env.local` and fill in your Supabase project values.
# `.env.local` is gitignored. Never commit real credentials.

# Supabase project URL (Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (safe for the browser). Older projects can use the anon key:
# VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: enable the Google button only after configuring the provider in
# Supabase → Authentication → Providers → Google. Without this, the button is
# shown as unavailable.
VITE_ENABLE_GOOGLE_AUTH=false

# NOTE: never place the service-role key or database password in a VITE_
# variable. Edge Functions receive SUPABASE_SERVICE_ROLE_KEY from Supabase.
